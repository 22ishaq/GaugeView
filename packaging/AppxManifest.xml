<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for GaugeView, a full-trust WPF desktop app. The release workflow fills in $VERSION$ and
  $PUBLISHER$; the publisher must match the subject of the certificate the package is signed with.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="IshaqAnsary.GaugeView" Publisher="$PUBLISHER$" Version="$VERSION$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>GaugeView</DisplayName>
    <PublisherDisplayName>Ishaq Ansary</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Measurement inspection for machined parts: tolerance checks, SPC control charts, capability and gauge R&amp;R.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-gb" />
  </Resources>

  <Applications>
    <Application Id="GaugeView" Executable="GaugeView.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="GaugeView"
        Description="Measurement inspection for machined parts"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
