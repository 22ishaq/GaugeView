<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the app compile on macOS and Linux too; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>GaugeView</AssemblyName>
    <ApplicationIcon>Assets\GaugeView.ico</ApplicationIcon>
    <Product>GaugeView</Product>
    <Description>Measurement inspection for machined parts</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GaugeView.Data\GaugeView.Data.csproj" />
    <ProjectReference Include="..\GaugeView.Presentation\GaugeView.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\*" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
