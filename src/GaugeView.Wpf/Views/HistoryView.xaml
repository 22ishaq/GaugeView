<UserControl x:Class="GaugeView.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GaugeView.Presentation;assembly=GaugeView.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             d:DesignWidth="1200" d:DesignHeight="640">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Save the inspection on screen -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Operator" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" Width="160" VerticalAlignment="Center" Padding="3,2" />
                <TextBlock Text="Batch / lot" VerticalAlignment="Center" Margin="16,0,8,0" />
                <TextBox Text="{Binding Batch, UpdateSourceTrigger=PropertyChanged}" Width="160" VerticalAlignment="Center" Padding="3,2" />
                <Button Content="Save current inspection" Command="{Binding SaveCommand}" Style="{StaticResource ToolButton}" Margin="16,0,0,0" />
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>

            <!-- Saved inspections -->
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Reopen selected" Command="{Binding ReopenCommand}" Padding="10,2" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Heading}" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Inspected" Binding="{Binding LocalTime, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="1.4*" />
                        <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="1.1*" />
                        <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="*" />
                        <DataGridTextColumn Header="Parts" Binding="{Binding PartCount}" Width="0.6*" />
                        <DataGridTextColumn Header="Pass" Binding="{Binding PassCount}" Width="0.6*" />
                        <DataGridTextColumn Header="Warn" Binding="{Binding WarningCount}" Width="0.6*" />
                        <DataGridTextColumn Header="Fail" Binding="{Binding FailCount}" Width="0.6*" />
                        <DataGridTextColumn Header="Incomplete" Binding="{Binding MissingCount}" Width="0.8*" />
                        <DataGridTextColumn Header="Yield" Binding="{Binding YieldPercent, StringFormat={}{0:0.0}%}" Width="0.7*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- One feature across batches -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding TrendFeatures}" SelectedItem="{Binding SelectedTrendFeature}" Width="170" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Trend across batches" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Trend}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="1.1*" />
                        <DataGridTextColumn Header="Inspected" Binding="{Binding LocalTime, StringFormat={}{0:dd MMM HH:mm}}" Width="1.1*" />
                        <DataGridTextColumn Header="n" Binding="{Binding SampleCount}" Width="0.5*" />
                        <DataGridTextColumn Header="Mean" Binding="{Binding Mean, StringFormat={}{0:0.0000}}" Width="*" />
                        <DataGridTextColumn Header="Min" Binding="{Binding Minimum}" Width="*" />
                        <DataGridTextColumn Header="Max" Binding="{Binding Maximum}" Width="*" />
                        <DataGridTextColumn Header="Cpk" Binding="{Binding Cpk, StringFormat={}{0:0.00}}" Width="0.7*" />
                        <DataGridTextColumn Header="Fails" Binding="{Binding FailCount}" Width="0.6*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}">
            <Run Text="Saved inspections are never edited or deleted. History file:" />
            <Run Text="{Binding Location, Mode=OneWay}" />
        </TextBlock>
    </Grid>
</UserControl>
